	"description": "TypeScript type definitions for Blues Code.",
	"publishConfig": {
		"access": "public",
		"name": "@blues-code/types",
		"registry": "https://registry.npmjs.org/"
	},
	"author": "Blues Code Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BluesCodeInc/Blues-Code.git"
	},
	"bugs": {
		"url": "https://github.com/BluesCodeInc/Blues-Code/issues"
	},
	"homepage": "https://bluescode.ai",
	"keywords": [
		"blues",
		"blues-code",
		"ai"
	],
	"main": "./dist/index.cjs",
